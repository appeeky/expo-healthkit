<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <queries>
    <package android:name="com.google.android.apps.healthdata" />
  </queries>

  <!--
    Health Connect uses-permission entries are declared by the config plugin
    (`healthConnectPermissions`), not here, so an app can narrow the list.
  -->

  <application>
    <activity
      android:name="expo.modules.healthkit.HealthConnectRationaleActivity"
      android:exported="true"
      android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar">
      <intent-filter>
        <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
      </intent-filter>
    </activity>
    <activity-alias
      android:name="ViewPermissionUsageActivity"
      android:exported="true"
      android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
      android:targetActivity="expo.modules.healthkit.HealthConnectRationaleActivity">
      <intent-filter>
        <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
        <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
      </intent-filter>
    </activity-alias>
  </application>
</manifest>
